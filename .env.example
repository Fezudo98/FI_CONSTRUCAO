# F.I Construção — configuração local do depósito
# Copie para .env, preencha e nunca envie o .env ao Git.

# Aplicação
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
FLASK_ENV=production

# Banco de dados: no depósito use PostgreSQL local (servidor da rede);
# para desenvolvimento rápido, sqlite:///fi_construcao.db funciona.
DATABASE_URL=postgresql+psycopg2://fi_construcao:troque-esta-senha@localhost:5432/fi_construcao

ENABLE_STOREFRONT=false
APP_TIMEZONE=America/Sao_Paulo
MAX_CONTENT_LENGTH_MB=16
RATELIMIT_STORAGE_URI=memory://

# Origem(ns) permitidas para chamadas à API a partir de outros PCs da rede local.
# Ex.: http://192.168.0.10:5000,http://192.168.0.11:5000
CORS_ORIGINS=

# Marca
BRAND_NAME=F.I Construção
BRAND_TAGLINE=Tudo para sua obra
BRAND_PRIMARY_COLOR=#08299B
BRAND_PRIMARY_DARK=#051D70
BRAND_ACCENT_COLOR=#FFA20A

# Criação do primeiro administrador (usado por scripts/create_dev_admin.py)
DEV_ADMIN_NAME=Administrador
DEV_ADMIN_EMAIL=admin@ficonstrucao.com.br
DEV_ADMIN_PASSWORD=

# Licenciamento (verificado pelo script de inicialização, não pela aplicação em si)
LICENSE_KEY=
LICENSE_CHECK_URL=https://admin.pumasystems.com.br/api/licenses/check
